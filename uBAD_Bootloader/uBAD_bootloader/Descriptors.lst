 156:Descriptors.c **** /** Language descriptor structure. This descriptor, located in SRAM memory, is returned when the ho
 157:Descriptors.c ****  *  the string descriptor with index 0 (the first index). It is actually an array of 16-bit integer
 158:Descriptors.c ****  *  via the language ID table available at USB.org what languages the device supports for its strin
 159:Descriptors.c ****  */
 160:Descriptors.c **** const USB_Descriptor_String_t LanguageString = {.Header = {.Size = USB_STRING_LEN(1), .Type = DTYPE
 161:Descriptors.c **** 
 162:Descriptors.c ****                                                 .UnicodeString = {LANGUAGE_ID_ENG}};
 163:Descriptors.c **** 
 164:Descriptors.c **** /** Product descriptor string. This is a Unicode string containing the product's details in human r
 165:Descriptors.c ****  *  and is read out upon request by the host when the appropriate string ID is requested, listed in
 166:Descriptors.c ****  *  Descriptor.
 167:Descriptors.c ****  */
 168:Descriptors.c **** const USB_Descriptor_String_t ProductString = {.Header = {.Size = USB_STRING_LEN(16), .Type = DTYPE
 169:Descriptors.c **** 
 170:Descriptors.c **** #if DEVICE_PID == 0x0037
 171:Descriptors.c ****                                                .UnicodeString = L"Arduino Micro   "
 172:Descriptors.c **** #elif DEVICE_PID == 0x003C
 173:Descriptors.c ****                                                .UnicodeString = L"Arduino Esplora "
 174:Descriptors.c **** #else
 175:Descriptors.c ****                                                .UnicodeString = L"uBAD Bootloader"
 176:Descriptors.c **** #endif
 177:Descriptors.c **** };
