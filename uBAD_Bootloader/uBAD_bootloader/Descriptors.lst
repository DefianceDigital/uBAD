  33:Descriptors.c **** /** \file
  34:Descriptors.c ****  *
  35:Descriptors.c ****  *  USB Device Descriptors, for library use when in USB device mode. Descriptors are special
  36:Descriptors.c ****  *  computer-readable structures which the host requests upon device enumeration, to determine
  37:Descriptors.c ****  *  the device's capabilities and functions.
  38:Descriptors.c ****  */
  39:Descriptors.c **** 
  40:Descriptors.c **** #include "Descriptors.h"
  41:Descriptors.c **** 
  42:Descriptors.c **** /** Device descriptor structure. This descriptor, located in SRAM memory, describes the overall
  43:Descriptors.c ****  *  device characteristics, including the supported USB version, control endpoint size and the
  44:Descriptors.c ****  *  number of device configurations. The descriptor is read out by the USB host when the enumeratio
  45:Descriptors.c ****  *  process begins.
  46:Descriptors.c ****  */
