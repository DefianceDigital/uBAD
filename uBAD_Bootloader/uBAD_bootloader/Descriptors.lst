  33:Descriptors.c **** /** \file
  34:Descriptors.c ****  *
  35:Descriptors.c ****  *  USB Device Descriptors, for library use when in USB device mode. Descriptors are special
  36:Descriptors.c ****  *  computer-readable structures which the host requests upon device enumeration, to determine
  37:Descriptors.c ****  *  the device's capabilities and functions.
  38:Descriptors.c ****  */
  39:Descriptors.c **** 
  40:Descriptors.c **** #include "Descriptors.h"
  41:Descriptors.c **** 
