  50:Descriptors.c ****                                                   .Class = CDC_CSCP_CDCClass,
  51:Descriptors.c ****                                                   .SubClass = CDC_CSCP_NoSpecificSubclass,
  52:Descriptors.c ****                                                   .Protocol = CDC_CSCP_NoSpecificProtocol,
  53:Descriptors.c **** 
  54:Descriptors.c ****                                                   .Endpoint0Size = FIXED_CONTROL_ENDPOINT_SIZE,
  55:Descriptors.c **** 
  56:Descriptors.c ****                                                   .VendorID = DEVICE_VID,
  57:Descriptors.c ****                                                   .ProductID = DEVICE_PID,
  58:Descriptors.c ****                                                   .ReleaseNumber = VERSION_BCD(00.01),
  59:Descriptors.c **** 
  60:Descriptors.c ****                                                   .ManufacturerStrIndex = 0x02,
  61:Descriptors.c ****                                                   .ProductStrIndex = 0x01,
  62:Descriptors.c ****                                                   .SerialNumStrIndex = NO_DESCRIPTOR,
  63:Descriptors.c **** 
  64:Descriptors.c ****                                                   .NumberOfConfigurations = FIXED_NUM_CONFIGURATION
  65:Descriptors.c **** 
  66:Descriptors.c **** /** Configuration descriptor structure. This descriptor, located in SRAM memory, describes the usag
  67:Descriptors.c ****  *  of the device in one of its supported configurations, including information about any device in
  68:Descriptors.c ****  *  and endpoints. The descriptor is read out by the USB host during the enumeration process when s
  69:Descriptors.c ****  *  a configuration so that the host may correctly communicate with the USB device.
  70:Descriptors.c ****  */
