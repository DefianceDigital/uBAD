 320:uBAD_bootloader.c **** #if !defined(NO_BLOCK_SUPPORT)
 321:uBAD_bootloader.c **** /** Reads or writes a block of EEPROM or FLASH memory to or from the appropriate CDC data endpoint,
 322:uBAD_bootloader.c ****  *  on the AVR910 protocol command issued.
 323:uBAD_bootloader.c ****  *
 324:uBAD_bootloader.c ****  *  \param[in] Command  Single character AVR910 protocol command indicating what memory operation t
 325:uBAD_bootloader.c ****  */
 326:uBAD_bootloader.c **** static void ReadWriteMemoryBlock(const uint8_t Command)
 327:uBAD_bootloader.c **** {
 328:uBAD_bootloader.c ****     uint16_t BlockSize;
 329:uBAD_bootloader.c ****     char MemoryType;
 330:uBAD_bootloader.c **** 
 331:uBAD_bootloader.c ****     bool HighByte = false;
 332:uBAD_bootloader.c ****     uint8_t LowByte = 0;
 333:uBAD_bootloader.c **** 
 334:uBAD_bootloader.c ****     BlockSize = (FetchNextCommandByte() << 8);
 335:uBAD_bootloader.c ****     BlockSize |= FetchNextCommandByte();
 336:uBAD_bootloader.c **** 
 337:uBAD_bootloader.c ****     MemoryType = FetchNextCommandByte();
 338:uBAD_bootloader.c **** 
 339:uBAD_bootloader.c ****     if ((MemoryType != 'E') && (MemoryType != 'F')) {
 340:uBAD_bootloader.c ****         /* Send error byte back to the host */
 341:uBAD_bootloader.c ****         WriteNextResponseByte('?');
 342:uBAD_bootloader.c **** 
 343:uBAD_bootloader.c ****         return;
 344:uBAD_bootloader.c ****     }
 345:uBAD_bootloader.c **** 
 346:uBAD_bootloader.c ****     /* Disable timer 1 interrupt - can't afford to process nonessential interrupts
 347:uBAD_bootloader.c ****      * while doing SPM tasks */
 348:uBAD_bootloader.c ****     TIMSK1 = 0;
 349:uBAD_bootloader.c **** 
 350:uBAD_bootloader.c ****     /* Check if command is to read memory */
 351:uBAD_bootloader.c ****     if (Command == 'g') {
 352:uBAD_bootloader.c ****         /* Re-enable RWW section */
 353:uBAD_bootloader.c ****         boot_rww_enable();
 354:uBAD_bootloader.c **** 
 355:uBAD_bootloader.c ****         while (BlockSize--) {
 356:uBAD_bootloader.c ****             if (MemoryType == 'F') {
 357:uBAD_bootloader.c **** /* Read the next FLASH byte from the current FLASH page */
 358:uBAD_bootloader.c **** #if (FLASHEND > 0xFFFF)
 359:uBAD_bootloader.c ****                 WriteNextResponseByte(pgm_read_byte_far(CurrAddress | HighByte));
 360:uBAD_bootloader.c **** #else
 361:uBAD_bootloader.c ****                 WriteNextResponseByte(pgm_read_byte(CurrAddress | HighByte));
 362:uBAD_bootloader.c **** #endif
 363:uBAD_bootloader.c **** 
 364:uBAD_bootloader.c ****                 /* If both bytes in current word have been read, increment the address counter */
 365:uBAD_bootloader.c ****                 if (HighByte) CurrAddress += 2;
 366:uBAD_bootloader.c **** 
 367:uBAD_bootloader.c ****                 HighByte = !HighByte;
 368:uBAD_bootloader.c ****             }
 369:uBAD_bootloader.c ****             else {
