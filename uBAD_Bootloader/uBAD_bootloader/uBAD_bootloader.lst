 280:uBAD_bootloader.c **** /** Event handler for the USB_ControlRequest event. This is used to catch and process control reque
 281:uBAD_bootloader.c ****  *  the device from the USB host before passing along unhandled control requests to the library for
 282:uBAD_bootloader.c ****  *  internally.
 283:uBAD_bootloader.c ****  */
 284:uBAD_bootloader.c **** void EVENT_USB_Device_ControlRequest(void)
 285:uBAD_bootloader.c **** {
 286:uBAD_bootloader.c ****     /* Ignore any requests that aren't directed to the CDC interface */
 287:uBAD_bootloader.c ****     if ((USB_ControlRequest.bmRequestType & (CONTROL_REQTYPE_TYPE | CONTROL_REQTYPE_RECIPIENT)) != 
 288:uBAD_bootloader.c ****         return;
 289:uBAD_bootloader.c ****     }
 290:uBAD_bootloader.c **** 
 291:uBAD_bootloader.c ****     /* Process CDC specific control requests */
 292:uBAD_bootloader.c ****     switch (USB_ControlRequest.bRequest) {
 293:uBAD_bootloader.c ****     case CDC_REQ_GetLineEncoding:
 294:uBAD_bootloader.c ****         if (USB_ControlRequest.bmRequestType == (REQDIR_DEVICETOHOST | REQTYPE_CLASS | REQREC_INTER
 295:uBAD_bootloader.c ****             Endpoint_ClearSETUP();
 296:uBAD_bootloader.c **** 
 297:uBAD_bootloader.c ****             /* Write the line coding data to the control endpoint */
 298:uBAD_bootloader.c ****             Endpoint_Write_Control_Stream_LE(&LineEncoding, sizeof(CDC_LineEncoding_t));
 299:uBAD_bootloader.c ****             Endpoint_ClearOUT();
 300:uBAD_bootloader.c ****         }
 301:uBAD_bootloader.c **** 
 302:uBAD_bootloader.c ****         break;
 303:uBAD_bootloader.c **** 
 304:uBAD_bootloader.c ****     /* patch/fix for mac os Catalina that fails on baudrate change : this is now broken!
 305:uBAD_bootloader.c ****     case CDC_REQ_SetControlLineState:
 306:uBAD_bootloader.c ****             if (USB_ControlRequest.bmRequestType == (REQDIR_HOSTTODEVICE | REQTYPE_CLASS | REQREC_I
 307:uBAD_bootloader.c ****             {
 308:uBAD_bootloader.c ****                     Endpoint_ClearSETUP();
 309:uBAD_bootloader.c ****                     Endpoint_ClearStatusStage();
 310:uBAD_bootloader.c ****             }
 311:uBAD_bootloader.c **** 
 312:uBAD_bootloader.c ****             break;
 313:uBAD_bootloader.c ****     */
 314:uBAD_bootloader.c **** 
 315:uBAD_bootloader.c ****     case CDC_REQ_SetLineEncoding:
 316:uBAD_bootloader.c ****         if (USB_ControlRequest.bmRequestType == (REQDIR_HOSTTODEVICE | REQTYPE_CLASS | REQREC_INTER
 317:uBAD_bootloader.c ****             Endpoint_ClearSETUP();
 318:uBAD_bootloader.c **** 
 319:uBAD_bootloader.c ****             /* Read the line coding data in from the host into the global struct */
 320:uBAD_bootloader.c ****             Endpoint_Read_Control_Stream_LE(&LineEncoding, sizeof(CDC_LineEncoding_t));
 321:uBAD_bootloader.c ****             Endpoint_ClearIN();
 322:uBAD_bootloader.c ****         }
 323:uBAD_bootloader.c **** 
 324:uBAD_bootloader.c ****         break;
 325:uBAD_bootloader.c ****     }
 326:uBAD_bootloader.c **** }
