 139:uBAD_bootloader.c **** 
 140:uBAD_bootloader.c **** int main(void)
 141:uBAD_bootloader.c **** {
 142:uBAD_bootloader.c **** 	
 143:uBAD_bootloader.c ****     /* Save the value of the boot key memory before it is overwritten */
 144:uBAD_bootloader.c ****     uint16_t bootKeyPtrVal = *bootKeyPtr;
 145:uBAD_bootloader.c ****     *bootKeyPtr = 0;
 146:uBAD_bootloader.c **** 
 147:uBAD_bootloader.c ****     /* Check the reason for the reset so we can act accordingly */
 148:uBAD_bootloader.c ****     uint8_t mcusr_state = MCUSR; // store the initial state of the Status register
 149:uBAD_bootloader.c ****     GPIOR0 = mcusr_state; // use GPIO0 register to preserve MCUSR for application use
 150:uBAD_bootloader.c ****     MCUSR = 0;                   // clear all reset flags
 151:uBAD_bootloader.c **** 
 152:uBAD_bootloader.c ****     /* Watchdog may be configured with a 15 ms period so must disable it before going any further *
 153:uBAD_bootloader.c ****     wdt_disable();
 154:uBAD_bootloader.c ****     
 155:uBAD_bootloader.c ****     uint8_t failedCount = eeprom_read_byte((uint8_t *)(intptr_t)(1));
 156:uBAD_bootloader.c ****     if((failedCount > 0x01) && (failedCount < 0xFF)){ // triggered by failed reValidate() in applic
 157:uBAD_bootloader.c ****       // Erase credentials in EEPROM without warning
 158:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)0, 0xFF); // erase first
 159:uBAD_bootloader.c ****       for(uint16_t i = 2; i < 1023; i++){
 160:uBAD_bootloader.c ****         eeprom_update_byte((uint8_t *)(intptr_t)i, 0xFF); // set all bytes to 0xFF that aren't alre
 161:uBAD_bootloader.c ****       }
 162:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)1, 0xFF); // erase last
 163:uBAD_bootloader.c ****     }
 164:uBAD_bootloader.c ****     
 165:uBAD_bootloader.c ****     if ((mcusr_state & (1 << PORF)) && (pgm_read_word(0) != 0xFFFF)) {
 166:uBAD_bootloader.c ****         // After a power-on reset skip the bootloader and jump straight to sketch if one exists.
 167:uBAD_bootloader.c ****         StartSketch();
 168:uBAD_bootloader.c ****     }
 169:uBAD_bootloader.c ****     else if ((mcusr_state & (1 << WDRF)) && (bootKeyPtrVal != bootKey) && (pgm_read_word(0) != 0xFF
 170:uBAD_bootloader.c ****         // If it looks like an "accidental" watchdog reset then start the sketch.
 171:uBAD_bootloader.c ****         StartSketch();
 172:uBAD_bootloader.c ****     }
 173:uBAD_bootloader.c ****     /*else if ((mcusr_state == (1 << BORF)) && (pgm_read_word(0) != 0xFFFF)) {
 174:uBAD_bootloader.c ****         // if brownout is the ONLY flag
 175:uBAD_bootloader.c ****         eeprom_update_byte((uint8_t *)(intptr_t)1, 0x02); // mark for reset next time in case of po
 176:uBAD_bootloader.c ****         StartSketch();
 177:uBAD_bootloader.c ****     }*/
 178:uBAD_bootloader.c ****     else { 
 179:uBAD_bootloader.c ****       // anything other than PORF or WDRF is likely a security attack. Erase credentials in EEPROM 
 180:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)0, 0xFF); // erase first
 181:uBAD_bootloader.c ****       for(uint16_t i = 2; i < 1023; i++){
 182:uBAD_bootloader.c ****         eeprom_update_byte((uint8_t *)(intptr_t)i, 0xFF); // set all bytes to 0xFF that aren't alre
 183:uBAD_bootloader.c ****       }
 184:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)1, 0xFF); // erase last
 185:uBAD_bootloader.c ****     }
 186:uBAD_bootloader.c **** 
 187:uBAD_bootloader.c ****     /* Setup hardware required for the bootloader */
 188:uBAD_bootloader.c ****     SetupHardware();
 189:uBAD_bootloader.c **** 	
 190:uBAD_bootloader.c **** 	  if (eeprom_read_byte((uint8_t *)(intptr_t)(1023)) == 187) { // bootkill (prevent updates)
 191:uBAD_bootloader.c ****         StartSketch();
 192:uBAD_bootloader.c ****     }
 193:uBAD_bootloader.c **** 
 194:uBAD_bootloader.c ****     // if we start sketch above we don't need usb etc.
 195:uBAD_bootloader.c ****     USB_Init();
 196:uBAD_bootloader.c **** 
 197:uBAD_bootloader.c ****     /* Enable global interrupts so that the USB stack can function */
 198:uBAD_bootloader.c ****     sei();
 199:uBAD_bootloader.c **** 
 200:uBAD_bootloader.c ****     Timeout = 0;
 201:uBAD_bootloader.c **** 
 202:uBAD_bootloader.c ****     while (RunBootloader) {
 203:uBAD_bootloader.c ****         CDC_Task();
 204:uBAD_bootloader.c ****         USB_USBTask();
 205:uBAD_bootloader.c ****         /* Time out and start the sketch if one is present */
 206:uBAD_bootloader.c ****         if (Timeout > TIMEOUT_PERIOD) RunBootloader = false;
 207:uBAD_bootloader.c **** 
 208:uBAD_bootloader.c ****         LEDPulse();
 209:uBAD_bootloader.c ****     }
 210:uBAD_bootloader.c **** 
 211:uBAD_bootloader.c ****     /* Disconnect from the host - USB interface will be reset later along with the AVR */
 212:uBAD_bootloader.c ****     USB_Detach();
 213:uBAD_bootloader.c **** 
 214:uBAD_bootloader.c ****     /* Jump to beginning of application space to run the sketch - do not reset */
 215:uBAD_bootloader.c ****     StartSketch();
 216:uBAD_bootloader.c **** }
 217:uBAD_bootloader.c **** 
 218:uBAD_bootloader.c **** /** Configures all hardware required for the bootloader. */
 219:uBAD_bootloader.c **** void SetupHardware(void)
 220:uBAD_bootloader.c **** {
 221:uBAD_bootloader.c ****     /* Disable watchdog if enabled by bootloader/fuses */
 222:uBAD_bootloader.c ****     MCUSR &= ~(1 << WDRF);
 223:uBAD_bootloader.c ****     wdt_disable();
 224:uBAD_bootloader.c **** 
 225:uBAD_bootloader.c ****     /* Disable clock division */
 226:uBAD_bootloader.c ****     clock_prescale_set(clock_div_1);
 227:uBAD_bootloader.c **** 
 228:uBAD_bootloader.c ****     /* Relocate the interrupt vector table to the bootloader section */
 229:uBAD_bootloader.c ****     MCUCR = (1 << IVCE);
 230:uBAD_bootloader.c ****     MCUCR = (1 << IVSEL);
 231:uBAD_bootloader.c **** 
 232:uBAD_bootloader.c ****     LED_SETUP();
 233:uBAD_bootloader.c ****     CPU_PRESCALE(0);
 234:uBAD_bootloader.c ****     L_LED_OFF();
 235:uBAD_bootloader.c ****     TX_LED_OFF();
 236:uBAD_bootloader.c ****     RX_LED_OFF();
 237:uBAD_bootloader.c **** 
 238:uBAD_bootloader.c ****     /* Initialize TIMER1 to handle bootloader timeout and LED tasks.
 239:uBAD_bootloader.c ****      * With 16 MHz clock and 1/64 prescaler, timer 1 is clocked at 250 kHz
 240:uBAD_bootloader.c ****      * Our chosen compare match generates an interrupt every 1 ms.
 241:uBAD_bootloader.c ****      * This interrupt is disabled selectively when doing memory reading, erasing,
 242:uBAD_bootloader.c ****      * or writing since SPM has tight timing requirements.
 243:uBAD_bootloader.c ****      */
 244:uBAD_bootloader.c ****     OCR1AH = 0;
 245:uBAD_bootloader.c ****     OCR1AL = 250;
 246:uBAD_bootloader.c ****     TIMSK1 = (1 << OCIE1A);               // enable timer 1 output compare A match interrupt
 247:uBAD_bootloader.c ****     TCCR1B = ((1 << CS11) | (1 << CS10)); // 1/64 prescaler on timer 1 input
 248:uBAD_bootloader.c **** 
 249:uBAD_bootloader.c ****     /* Initialize USB Subsystem */
 250:uBAD_bootloader.c ****     // USB_Init(); we do that later
 251:uBAD_bootloader.c **** }
 252:uBAD_bootloader.c **** 
 253:uBAD_bootloader.c **** // uint16_t ctr = 0;
 254:uBAD_bootloader.c **** ISR(TIMER1_COMPA_vect, ISR_BLOCK)
 255:uBAD_bootloader.c **** {
 256:uBAD_bootloader.c ****     /* Reset counter */
 257:uBAD_bootloader.c ****     TCNT1H = 0;
 258:uBAD_bootloader.c ****     TCNT1L = 0;
 259:uBAD_bootloader.c **** 
 260:uBAD_bootloader.c ****     /* Check whether the TX or RX LED one-shot period has elapsed.  if so, turn off the LED */
 261:uBAD_bootloader.c ****     if (TxLEDPulse && !(--TxLEDPulse)) TX_LED_OFF();
 262:uBAD_bootloader.c ****     if (RxLEDPulse && !(--RxLEDPulse)) RX_LED_OFF();
 263:uBAD_bootloader.c **** 
 264:uBAD_bootloader.c ****     if (pgm_read_word(0) != 0xFFFF) Timeout++;
 265:uBAD_bootloader.c **** }
