  33:/usr/avr/sys-root/include/avr/wdt.h **** 
  34:/usr/avr/sys-root/include/avr/wdt.h **** /*
  35:/usr/avr/sys-root/include/avr/wdt.h ****    avr/wdt.h - macros for AVR watchdog timer
  36:/usr/avr/sys-root/include/avr/wdt.h ****  */
  37:/usr/avr/sys-root/include/avr/wdt.h **** 
  38:/usr/avr/sys-root/include/avr/wdt.h **** #ifndef _AVR_WDT_H_
  39:/usr/avr/sys-root/include/avr/wdt.h **** #define _AVR_WDT_H_
  40:/usr/avr/sys-root/include/avr/wdt.h **** 
  41:/usr/avr/sys-root/include/avr/wdt.h **** #include <avr/io.h>
  42:/usr/avr/sys-root/include/avr/wdt.h **** #include <stdint.h>
  43:/usr/avr/sys-root/include/avr/wdt.h **** 
  44:/usr/avr/sys-root/include/avr/wdt.h **** /** \file */
  45:/usr/avr/sys-root/include/avr/wdt.h **** /** \defgroup avr_watchdog <avr/wdt.h>: Watchdog timer handling
  46:/usr/avr/sys-root/include/avr/wdt.h ****     \code #include <avr/wdt.h> \endcode
  47:/usr/avr/sys-root/include/avr/wdt.h **** 
  48:/usr/avr/sys-root/include/avr/wdt.h ****     This header file declares the interface to some inline macros
  49:/usr/avr/sys-root/include/avr/wdt.h ****     handling the watchdog timer present in many AVR devices.  In order
  50:/usr/avr/sys-root/include/avr/wdt.h ****     to prevent the watchdog timer configuration from being
  51:/usr/avr/sys-root/include/avr/wdt.h ****     accidentally altered by a crashing application, a special timed
  52:/usr/avr/sys-root/include/avr/wdt.h ****     sequence is required in order to change it.  The macros within
  53:/usr/avr/sys-root/include/avr/wdt.h ****     this header file handle the required sequence automatically
  54:/usr/avr/sys-root/include/avr/wdt.h ****     before changing any value.  Interrupts will be disabled during
  55:/usr/avr/sys-root/include/avr/wdt.h ****     the manipulation.
  56:/usr/avr/sys-root/include/avr/wdt.h **** 
  57:/usr/avr/sys-root/include/avr/wdt.h ****     \note Depending on the fuse configuration of the particular
  58:/usr/avr/sys-root/include/avr/wdt.h ****     device, further restrictions might apply, in particular it might
  59:/usr/avr/sys-root/include/avr/wdt.h ****     be disallowed to turn off the watchdog timer.
  60:/usr/avr/sys-root/include/avr/wdt.h **** 
  61:/usr/avr/sys-root/include/avr/wdt.h ****     Note that for newer devices (ATmega88 and newer, effectively any
  62:/usr/avr/sys-root/include/avr/wdt.h ****     AVR that has the option to also generate interrupts), the watchdog
  63:/usr/avr/sys-root/include/avr/wdt.h ****     timer remains active even after a system reset (except a power-on
  64:/usr/avr/sys-root/include/avr/wdt.h ****     condition), using the fastest prescaler value (approximately 15
  65:/usr/avr/sys-root/include/avr/wdt.h ****     ms).  It is therefore required to turn off the watchdog early
  66:/usr/avr/sys-root/include/avr/wdt.h ****     during program startup, the datasheet recommends a sequence like
  67:/usr/avr/sys-root/include/avr/wdt.h ****     the following:
  68:/usr/avr/sys-root/include/avr/wdt.h **** 
  69:/usr/avr/sys-root/include/avr/wdt.h ****     \code
  70:/usr/avr/sys-root/include/avr/wdt.h ****     #include <stdint.h>
  71:/usr/avr/sys-root/include/avr/wdt.h ****     #include <avr/wdt.h>
  72:/usr/avr/sys-root/include/avr/wdt.h **** 
  73:/usr/avr/sys-root/include/avr/wdt.h ****     uint8_t mcusr_mirror __attribute__ ((section (".noinit")));
  74:/usr/avr/sys-root/include/avr/wdt.h **** 
  75:/usr/avr/sys-root/include/avr/wdt.h ****     void get_mcusr(void) \
  76:/usr/avr/sys-root/include/avr/wdt.h ****       __attribute__((naked)) \
  77:/usr/avr/sys-root/include/avr/wdt.h ****       __attribute__((section(".init3")));
  78:/usr/avr/sys-root/include/avr/wdt.h ****     void get_mcusr(void)
  79:/usr/avr/sys-root/include/avr/wdt.h ****     {
  80:/usr/avr/sys-root/include/avr/wdt.h ****       mcusr_mirror = MCUSR;
  81:/usr/avr/sys-root/include/avr/wdt.h ****       MCUSR = 0;
  82:/usr/avr/sys-root/include/avr/wdt.h ****       wdt_disable();
  83:/usr/avr/sys-root/include/avr/wdt.h ****     }
  84:/usr/avr/sys-root/include/avr/wdt.h ****     \endcode
  85:/usr/avr/sys-root/include/avr/wdt.h **** 
  86:/usr/avr/sys-root/include/avr/wdt.h ****     Saving the value of MCUSR in \c mcusr_mirror is only needed if the
  87:/usr/avr/sys-root/include/avr/wdt.h ****     application later wants to examine the reset source, but in particular, 
  88:/usr/avr/sys-root/include/avr/wdt.h ****     clearing the watchdog reset flag before disabling the
  89:/usr/avr/sys-root/include/avr/wdt.h ****     watchdog is required, according to the datasheet.
  90:/usr/avr/sys-root/include/avr/wdt.h **** */
  91:/usr/avr/sys-root/include/avr/wdt.h **** 
  92:/usr/avr/sys-root/include/avr/wdt.h **** /**
  93:/usr/avr/sys-root/include/avr/wdt.h ****    \ingroup avr_watchdog
  94:/usr/avr/sys-root/include/avr/wdt.h ****    Reset the watchdog timer.  When the watchdog timer is enabled,
  95:/usr/avr/sys-root/include/avr/wdt.h ****    a call to this instruction is required before the timer expires,
  96:/usr/avr/sys-root/include/avr/wdt.h ****    otherwise a watchdog-initiated device reset will occur. 
  97:/usr/avr/sys-root/include/avr/wdt.h **** */
