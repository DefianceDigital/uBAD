 328:uBAD_bootloader.c **** #if !defined(NO_BLOCK_SUPPORT)
 329:uBAD_bootloader.c **** /** Reads or writes a block of EEPROM or FLASH memory to or from the appropriate CDC data endpoint,
 330:uBAD_bootloader.c ****  *  on the AVR910 protocol command issued.
 331:uBAD_bootloader.c ****  *
 332:uBAD_bootloader.c ****  *  \param[in] Command  Single character AVR910 protocol command indicating what memory operation t
 333:uBAD_bootloader.c ****  */
 334:uBAD_bootloader.c **** static void ReadWriteMemoryBlock(const uint8_t Command)
 335:uBAD_bootloader.c **** {
 336:uBAD_bootloader.c ****     uint16_t BlockSize;
 337:uBAD_bootloader.c ****     char MemoryType;
 338:uBAD_bootloader.c **** 
 339:uBAD_bootloader.c ****     bool HighByte = false;
 340:uBAD_bootloader.c ****     uint8_t LowByte = 0;
 341:uBAD_bootloader.c **** 
 342:uBAD_bootloader.c ****     BlockSize = (FetchNextCommandByte() << 8);
 343:uBAD_bootloader.c ****     BlockSize |= FetchNextCommandByte();
 344:uBAD_bootloader.c **** 
 345:uBAD_bootloader.c ****     MemoryType = FetchNextCommandByte();
 346:uBAD_bootloader.c **** 
 347:uBAD_bootloader.c ****     if ((MemoryType != 'E') && (MemoryType != 'F')) {
 348:uBAD_bootloader.c ****         /* Send error byte back to the host */
 349:uBAD_bootloader.c ****         WriteNextResponseByte('?');
 350:uBAD_bootloader.c **** 
 351:uBAD_bootloader.c ****         return;
 352:uBAD_bootloader.c ****     }
 353:uBAD_bootloader.c **** 
 354:uBAD_bootloader.c ****     /* Disable timer 1 interrupt - can't afford to process nonessential interrupts
 355:uBAD_bootloader.c ****      * while doing SPM tasks */
 356:uBAD_bootloader.c ****     TIMSK1 = 0;
 357:uBAD_bootloader.c **** 
 358:uBAD_bootloader.c ****     /* Check if command is to read memory */
 359:uBAD_bootloader.c ****     if (Command == 'g') {
 360:uBAD_bootloader.c ****         /* Re-enable RWW section */
 361:uBAD_bootloader.c ****         boot_rww_enable();
 362:uBAD_bootloader.c **** 
 363:uBAD_bootloader.c ****         while (BlockSize--) {
 364:uBAD_bootloader.c ****             if (MemoryType == 'F') {
 365:uBAD_bootloader.c **** /* Read the next FLASH byte from the current FLASH page */
