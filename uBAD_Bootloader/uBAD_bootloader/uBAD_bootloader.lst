  39:uBAD_bootloader.c **** #define INCLUDE_FROM_UBAD_C
  40:uBAD_bootloader.c **** #include "uBAD_bootloader.h"
  41:uBAD_bootloader.c **** 
  42:uBAD_bootloader.c **** /** Contains the current baud rate and other settings of the first virtual serial port. This must b
  43:uBAD_bootloader.c ****  *  operating systems will not open the port unless the settings can be set successfully.
  44:uBAD_bootloader.c ****  */
  45:uBAD_bootloader.c **** static CDC_LineEncoding_t LineEncoding = {
  46:uBAD_bootloader.c ****     .BaudRateBPS = 0, .CharFormat = CDC_LINEENCODING_OneStopBit, .ParityType = CDC_PARITY_None, .Da
  47:uBAD_bootloader.c **** 
  48:uBAD_bootloader.c **** /** Current address counter. This stores the current address of the FLASH or EEPROM as set by the h
  49:uBAD_bootloader.c ****  *  and is used when reading or writing to the AVRs memory (either FLASH or EEPROM depending on the
  50:uBAD_bootloader.c ****  *  command.)
  51:uBAD_bootloader.c ****  */
  52:uBAD_bootloader.c **** static uint32_t CurrAddress;
  53:uBAD_bootloader.c **** 
  54:uBAD_bootloader.c **** /** Flag to indicate if the bootloader should be running, or should exit and allow the application 
  55:uBAD_bootloader.c ****  *  via a watchdog reset. When cleared the bootloader will exit, starting the watchdog and entering
  56:uBAD_bootloader.c ****  *  loop until the AVR restarts and the application runs.
  57:uBAD_bootloader.c ****  */
  58:uBAD_bootloader.c **** static bool RunBootloader = true;
  59:uBAD_bootloader.c **** 
  60:uBAD_bootloader.c **** /* Pulse generation counters to keep track of the time remaining for each pulse type */
  61:uBAD_bootloader.c **** #define TX_RX_LED_PULSE_PERIOD 100
  62:uBAD_bootloader.c **** uint16_t TxLEDPulse = 0; // time remaining for Tx LED pulse
  63:uBAD_bootloader.c **** uint16_t RxLEDPulse = 0; // time remaining for Rx LED pulse
  64:uBAD_bootloader.c **** 
  65:uBAD_bootloader.c **** /* Bootloader timeout timer */
  66:uBAD_bootloader.c **** #define TIMEOUT_PERIOD 16000 // default is 8000
  67:uBAD_bootloader.c **** uint16_t Timeout = 0;
  68:uBAD_bootloader.c **** 
  69:uBAD_bootloader.c **** uint16_t bootKey = 0x7777;
  70:uBAD_bootloader.c **** volatile uint16_t *const bootKeyPtr = (volatile uint16_t *)0x0800;
  71:uBAD_bootloader.c **** 
  72:uBAD_bootloader.c **** void StartSketch(void)
  73:uBAD_bootloader.c **** {
  74:uBAD_bootloader.c ****     cli();
  75:uBAD_bootloader.c **** 
  76:uBAD_bootloader.c ****     /* Undo TIMER1 setup and clear the count before running the sketch */
  77:uBAD_bootloader.c ****     TIMSK1 = 0;
  78:uBAD_bootloader.c ****     TCCR1B = 0;
  79:uBAD_bootloader.c ****     TCNT1H = 0; // 16-bit write to TCNT1 requires high byte be written first
  80:uBAD_bootloader.c ****     TCNT1L = 0;
  81:uBAD_bootloader.c **** 
  82:uBAD_bootloader.c ****     /* Relocate the interrupt vector table to the application section */
  83:uBAD_bootloader.c ****     MCUCR = (1 << IVCE);
  84:uBAD_bootloader.c ****     MCUCR = 0;
  85:uBAD_bootloader.c **** 
  86:uBAD_bootloader.c ****     L_LED_OFF();
  87:uBAD_bootloader.c ****     TX_LED_OFF();
  88:uBAD_bootloader.c ****     RX_LED_OFF();
  89:uBAD_bootloader.c **** 
  90:uBAD_bootloader.c ****     /* jump to beginning of application space */
  91:uBAD_bootloader.c ****     __asm__ volatile("jmp 0x0000");
  92:uBAD_bootloader.c **** }
  93:uBAD_bootloader.c **** 
  94:uBAD_bootloader.c **** /*	Breathing animation on L LED indicates bootloader is running */
  95:uBAD_bootloader.c **** uint16_t LLEDPulse;
  96:uBAD_bootloader.c **** void LEDPulse(void)
  97:uBAD_bootloader.c **** {
  98:uBAD_bootloader.c ****     LLEDPulse++;
  99:uBAD_bootloader.c ****     uint8_t p = LLEDPulse >> 8;
 100:uBAD_bootloader.c ****     if (p > 127) p = 254 - p;
 101:uBAD_bootloader.c ****     p += p;
 102:uBAD_bootloader.c ****     if (((uint8_t)LLEDPulse) > p)
 103:uBAD_bootloader.c ****         L_LED_OFF();
 104:uBAD_bootloader.c ****     else
 105:uBAD_bootloader.c ****         L_LED_ON();
 106:uBAD_bootloader.c **** }
 107:uBAD_bootloader.c **** 
 108:uBAD_bootloader.c **** /** Main program entry point. This routine configures the hardware required by the bootloader, then
 109:uBAD_bootloader.c ****  *  runs the bootloader processing routine until it times out or is instructed to exit.
 110:uBAD_bootloader.c ****  */
 111:uBAD_bootloader.c **** 
 112:uBAD_bootloader.c **** // hard blink to debug
 113:uBAD_bootloader.c **** void xdelay(int n)
 114:uBAD_bootloader.c **** {
 115:uBAD_bootloader.c ****     for (int j = 1; j < 500; j++)
 116:uBAD_bootloader.c ****         for (int i = 0; i < n; i++) {
 117:uBAD_bootloader.c **** 
 118:uBAD_bootloader.c ****             __asm__ volatile("LDI ZH,0xFF ;Set high byte"
 119:uBAD_bootloader.c ****                              "LDI ZL,0xFF ;Set low byte"
 120:uBAD_bootloader.c ****                              "DelayLoop: "
 121:uBAD_bootloader.c ****                              "  SBIW ZL,1 ;subtract one from word "
 122:uBAD_bootloader.c ****                              "  BRNE DelayLoop ;Branch back to DelayLoop unless zero flag was set "
 123:uBAD_bootloader.c ****                              "LDI ZH,0xFF ;Set high byte"
 124:uBAD_bootloader.c ****                              "LDI ZL,0xFF ;Set low byte"
 125:uBAD_bootloader.c ****                              "DelayLoop2: "
 126:uBAD_bootloader.c ****                              "  SBIW ZL,1 ;subtract one from word "
 127:uBAD_bootloader.c ****                              "  BRNE DelayLoop2 ;Branch back to DelayLoop unless zero flag was set 
 128:uBAD_bootloader.c ****         }
 129:uBAD_bootloader.c **** }
 130:uBAD_bootloader.c **** 
 131:uBAD_bootloader.c **** void blink()
 132:uBAD_bootloader.c **** {
 133:uBAD_bootloader.c ****     L_LED_ON();
 134:uBAD_bootloader.c ****     xdelay(1000);
 135:uBAD_bootloader.c ****     L_LED_OFF();
 136:uBAD_bootloader.c ****     xdelay(2000);
 137:uBAD_bootloader.c **** }
 138:uBAD_bootloader.c **** 
 139:uBAD_bootloader.c **** 
 140:uBAD_bootloader.c **** int main(void)
 141:uBAD_bootloader.c **** {
 142:uBAD_bootloader.c ****     /* Save the value of the boot key memory before it is overwritten */
 143:uBAD_bootloader.c ****     uint16_t bootKeyPtrVal = *bootKeyPtr;
 144:uBAD_bootloader.c ****     *bootKeyPtr = 0;
 145:uBAD_bootloader.c **** 
 146:uBAD_bootloader.c ****     /* Check the reason for the reset so we can act accordingly */
 147:uBAD_bootloader.c ****     uint8_t mcusr_state = MCUSR; // store the initial state of the Status register
 148:uBAD_bootloader.c ****     GPIOR0 = mcusr_state; // use GPIO0 register to preserve MCUSR for application use
 149:uBAD_bootloader.c ****     MCUSR = 0;                   // clear all reset flags
 150:uBAD_bootloader.c **** 
 151:uBAD_bootloader.c ****     /* Watchdog may be configured with a 15 ms period so must disable it before going any further *
 152:uBAD_bootloader.c ****     wdt_disable();
 153:uBAD_bootloader.c ****     
 154:uBAD_bootloader.c ****     /*uint8_t failedCount = eeprom_read_byte((uint8_t *)(intptr_t)(1));
 155:uBAD_bootloader.c ****     if((failedCount > 0x01) && (failedCount < 0xFF)){ // triggered by failed reValidate() in applic
 156:uBAD_bootloader.c ****       // Erase credentials in EEPROM without warning
 157:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)0, 0xFF); // erase first
 158:uBAD_bootloader.c ****       for(uint16_t i = 2; i < 1023; i++){
 159:uBAD_bootloader.c ****         eeprom_update_byte((uint8_t *)(intptr_t)i, 0xFF); // set all bytes to 0xFF that aren't alre
 160:uBAD_bootloader.c ****       }
 161:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)1, 0xFF); // erase last
 162:uBAD_bootloader.c ****     }*/
 163:uBAD_bootloader.c ****     if ((mcusr_state & (1 << PORF)) && (pgm_read_word(0) != 0xFFFF)) {
 164:uBAD_bootloader.c ****         // After a power-on reset skip the bootloader and jump straight to sketch if one exists.
 165:uBAD_bootloader.c ****         StartSketch();
 166:uBAD_bootloader.c ****     }
 167:uBAD_bootloader.c ****     else if ((mcusr_state & (1 << WDRF)) && (bootKeyPtrVal != bootKey) && (pgm_read_word(0) != 0xFF
 168:uBAD_bootloader.c ****         // If it looks like an "accidental" watchdog reset then start the sketch.
 169:uBAD_bootloader.c ****         StartSketch();
 170:uBAD_bootloader.c ****     } else { 
 171:uBAD_bootloader.c ****       // anything other than PORF or WDRF is likely a security attack. Erase credentials in EEPROM 
 172:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)0, 0xFF); // erase first
 173:uBAD_bootloader.c ****       for(uint16_t i = 2; i < 1023; i++){
 174:uBAD_bootloader.c ****         eeprom_update_byte((uint8_t *)(intptr_t)i, 0xFF); // set all bytes to 0xFF that aren't alre
 175:uBAD_bootloader.c ****       }
 176:uBAD_bootloader.c ****       eeprom_update_byte((uint8_t *)(intptr_t)1, 0xFF); // erase last
 177:uBAD_bootloader.c ****     }
 178:uBAD_bootloader.c ****     
 179:uBAD_bootloader.c ****     if (eeprom_read_byte((uint8_t *)(intptr_t)(1023)) == 187) { // bootkill (prevent updates)
 180:uBAD_bootloader.c ****         StartSketch();
 181:uBAD_bootloader.c ****     }
 182:uBAD_bootloader.c **** 
 183:uBAD_bootloader.c ****     /* Setup hardware required for the bootloader */
 184:uBAD_bootloader.c ****     SetupHardware();
 185:uBAD_bootloader.c **** 
 186:uBAD_bootloader.c ****     // if we start sketch above we don't need usb etc.
 187:uBAD_bootloader.c ****     USB_Init();
 188:uBAD_bootloader.c **** 
 189:uBAD_bootloader.c ****     /* Enable global interrupts so that the USB stack can function */
 190:uBAD_bootloader.c ****     sei();
 191:uBAD_bootloader.c **** 
 192:uBAD_bootloader.c ****     Timeout = 0;
 193:uBAD_bootloader.c **** 
 194:uBAD_bootloader.c ****     while (RunBootloader) {
 195:uBAD_bootloader.c ****         CDC_Task();
 196:uBAD_bootloader.c ****         USB_USBTask();
 197:uBAD_bootloader.c ****         /* Time out and start the sketch if one is present */
 198:uBAD_bootloader.c ****         if (Timeout > TIMEOUT_PERIOD) RunBootloader = false;
 199:uBAD_bootloader.c **** 
 200:uBAD_bootloader.c ****         LEDPulse();
 201:uBAD_bootloader.c ****     }
 202:uBAD_bootloader.c **** 
 203:uBAD_bootloader.c ****     /* Disconnect from the host - USB interface will be reset later along with the AVR */
 204:uBAD_bootloader.c ****     USB_Detach();
 205:uBAD_bootloader.c **** 
 206:uBAD_bootloader.c ****     /* Jump to beginning of application space to run the sketch - do not reset */
 207:uBAD_bootloader.c ****     StartSketch();
 208:uBAD_bootloader.c **** }
 209:uBAD_bootloader.c **** 
 210:uBAD_bootloader.c **** /** Configures all hardware required for the bootloader. */
 211:uBAD_bootloader.c **** void SetupHardware(void)
 212:uBAD_bootloader.c **** {
 213:uBAD_bootloader.c ****     /* Disable watchdog if enabled by bootloader/fuses */
 214:uBAD_bootloader.c ****     MCUSR &= ~(1 << WDRF);
 215:uBAD_bootloader.c ****     wdt_disable();
 216:uBAD_bootloader.c **** 
 217:uBAD_bootloader.c ****     /* Disable clock division */
 218:uBAD_bootloader.c ****     clock_prescale_set(clock_div_1);
 219:uBAD_bootloader.c **** 
 220:uBAD_bootloader.c ****     /* Relocate the interrupt vector table to the bootloader section */
 221:uBAD_bootloader.c ****     MCUCR = (1 << IVCE);
 222:uBAD_bootloader.c ****     MCUCR = (1 << IVSEL);
 223:uBAD_bootloader.c **** 
 224:uBAD_bootloader.c ****     LED_SETUP();
 225:uBAD_bootloader.c ****     CPU_PRESCALE(0);
 226:uBAD_bootloader.c ****     L_LED_OFF();
 227:uBAD_bootloader.c ****     TX_LED_OFF();
 228:uBAD_bootloader.c ****     RX_LED_OFF();
 229:uBAD_bootloader.c **** 
 230:uBAD_bootloader.c ****     /* Initialize TIMER1 to handle bootloader timeout and LED tasks.
 231:uBAD_bootloader.c ****      * With 16 MHz clock and 1/64 prescaler, timer 1 is clocked at 250 kHz
 232:uBAD_bootloader.c ****      * Our chosen compare match generates an interrupt every 1 ms.
 233:uBAD_bootloader.c ****      * This interrupt is disabled selectively when doing memory reading, erasing,
 234:uBAD_bootloader.c ****      * or writing since SPM has tight timing requirements.
 235:uBAD_bootloader.c ****      */
 236:uBAD_bootloader.c ****     OCR1AH = 0;
 237:uBAD_bootloader.c ****     OCR1AL = 250;
 238:uBAD_bootloader.c ****     TIMSK1 = (1 << OCIE1A);               // enable timer 1 output compare A match interrupt
 239:uBAD_bootloader.c ****     TCCR1B = ((1 << CS11) | (1 << CS10)); // 1/64 prescaler on timer 1 input
 240:uBAD_bootloader.c **** 
 241:uBAD_bootloader.c ****     /* Initialize USB Subsystem */
 242:uBAD_bootloader.c ****     // USB_Init(); we do that later
 243:uBAD_bootloader.c **** }
 244:uBAD_bootloader.c **** 
 245:uBAD_bootloader.c **** // uint16_t ctr = 0;
 246:uBAD_bootloader.c **** ISR(TIMER1_COMPA_vect, ISR_BLOCK)
 247:uBAD_bootloader.c **** {
 248:uBAD_bootloader.c ****     /* Reset counter */
 249:uBAD_bootloader.c ****     TCNT1H = 0;
 250:uBAD_bootloader.c ****     TCNT1L = 0;
 251:uBAD_bootloader.c **** 
 252:uBAD_bootloader.c ****     /* Check whether the TX or RX LED one-shot period has elapsed.  if so, turn off the LED */
 253:uBAD_bootloader.c ****     if (TxLEDPulse && !(--TxLEDPulse)) TX_LED_OFF();
 254:uBAD_bootloader.c ****     if (RxLEDPulse && !(--RxLEDPulse)) RX_LED_OFF();
 255:uBAD_bootloader.c **** 
 256:uBAD_bootloader.c ****     if (pgm_read_word(0) != 0xFFFF) Timeout++;
 257:uBAD_bootloader.c **** }
