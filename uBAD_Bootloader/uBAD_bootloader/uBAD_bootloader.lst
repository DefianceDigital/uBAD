 272:uBAD_bootloader.c **** /** Event handler for the USB_ControlRequest event. This is used to catch and process control reque
 273:uBAD_bootloader.c ****  *  the device from the USB host before passing along unhandled control requests to the library for
 274:uBAD_bootloader.c ****  *  internally.
 275:uBAD_bootloader.c ****  */
 276:uBAD_bootloader.c **** void EVENT_USB_Device_ControlRequest(void)
 277:uBAD_bootloader.c **** {
 278:uBAD_bootloader.c ****     /* Ignore any requests that aren't directed to the CDC interface */
 279:uBAD_bootloader.c ****     if ((USB_ControlRequest.bmRequestType & (CONTROL_REQTYPE_TYPE | CONTROL_REQTYPE_RECIPIENT)) != 
 280:uBAD_bootloader.c ****         return;
 281:uBAD_bootloader.c ****     }
 282:uBAD_bootloader.c **** 
 283:uBAD_bootloader.c ****     /* Process CDC specific control requests */
 284:uBAD_bootloader.c ****     switch (USB_ControlRequest.bRequest) {
 285:uBAD_bootloader.c ****     case CDC_REQ_GetLineEncoding:
 286:uBAD_bootloader.c ****         if (USB_ControlRequest.bmRequestType == (REQDIR_DEVICETOHOST | REQTYPE_CLASS | REQREC_INTER
 287:uBAD_bootloader.c ****             Endpoint_ClearSETUP();
 288:uBAD_bootloader.c **** 
 289:uBAD_bootloader.c ****             /* Write the line coding data to the control endpoint */
 290:uBAD_bootloader.c ****             Endpoint_Write_Control_Stream_LE(&LineEncoding, sizeof(CDC_LineEncoding_t));
 291:uBAD_bootloader.c ****             Endpoint_ClearOUT();
 292:uBAD_bootloader.c ****         }
 293:uBAD_bootloader.c **** 
 294:uBAD_bootloader.c ****         break;
 295:uBAD_bootloader.c **** 
 296:uBAD_bootloader.c ****     /* patch/fix for mac os Catalina that fails on baudrate change : this is now broken!
 297:uBAD_bootloader.c ****     case CDC_REQ_SetControlLineState:
 298:uBAD_bootloader.c ****             if (USB_ControlRequest.bmRequestType == (REQDIR_HOSTTODEVICE | REQTYPE_CLASS | REQREC_I
 299:uBAD_bootloader.c ****             {
 300:uBAD_bootloader.c ****                     Endpoint_ClearSETUP();
 301:uBAD_bootloader.c ****                     Endpoint_ClearStatusStage();
 302:uBAD_bootloader.c ****             }
 303:uBAD_bootloader.c **** 
 304:uBAD_bootloader.c ****             break;
 305:uBAD_bootloader.c ****     */
 306:uBAD_bootloader.c **** 
 307:uBAD_bootloader.c ****     case CDC_REQ_SetLineEncoding:
 308:uBAD_bootloader.c ****         if (USB_ControlRequest.bmRequestType == (REQDIR_HOSTTODEVICE | REQTYPE_CLASS | REQREC_INTER
 309:uBAD_bootloader.c ****             Endpoint_ClearSETUP();
 310:uBAD_bootloader.c **** 
 311:uBAD_bootloader.c ****             /* Read the line coding data in from the host into the global struct */
 312:uBAD_bootloader.c ****             Endpoint_Read_Control_Stream_LE(&LineEncoding, sizeof(CDC_LineEncoding_t));
 313:uBAD_bootloader.c ****             Endpoint_ClearIN();
 314:uBAD_bootloader.c ****         }
 315:uBAD_bootloader.c **** 
 316:uBAD_bootloader.c ****         break;
 317:uBAD_bootloader.c ****     }
 318:uBAD_bootloader.c **** }
