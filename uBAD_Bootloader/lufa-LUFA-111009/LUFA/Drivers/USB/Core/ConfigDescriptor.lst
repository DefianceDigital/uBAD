  84:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 
  85:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			/** Casts a pointer to a descriptor inside the configuration descriptor into the given descripto
  86:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  type (as an actual struct instance rather than a pointer to a struct).
  87:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
  88:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  Usage Example:
  89:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \code
  90:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  uint8_t* CurrDescriptor = &ConfigDescriptor[0]; // Pointing to the configuration header
  91:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  USB_Descriptor_Configuration_Header_t ConfigHeader = DESCRIPTOR_CAST(CurrDescriptor,
  92:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *                                                       USB_Descriptor_Configuration_Header_t);
  93:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
  94:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  // Can now access elements of the configuration header struct using the . operator
  95:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \endcode
  96:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 */
  97:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			#define DESCRIPTOR_CAST(DescriptorPtr, Type)  (*DESCRIPTOR_PCAST(DescriptorPtr, Type))
