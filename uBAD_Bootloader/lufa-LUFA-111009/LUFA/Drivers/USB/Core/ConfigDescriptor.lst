 226:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \param[in,out] CurrConfigLoc      Pointer to the current position in the configuration descr
 227:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \param[in]     ComparatorRoutine  Name of the comparator search function to use on the confi
 228:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
 229:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \return Value of one of the members of the \ref DSearch_Comp_Return_ErrorCodes_t enum.
 230:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
 231:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  Usage Example:
 232:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \code
 233:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  uint8_t EndpointSearcher(void* CurrentDescriptor); // Comparator Prototype
 234:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
 235:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  uint8_t EndpointSearcher(void* CurrentDescriptor)
 236:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  {
 237:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *     if (DESCRIPTOR_TYPE(CurrentDescriptor) == DTYPE_Endpoint)
 238:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *         return DESCRIPTOR_SEARCH_Found;
 239:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *     else
 240:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *         return DESCRIPTOR_SEARCH_NotFound;
 241:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  }
 242:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
 243:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  //...
 244:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  // After retrieving configuration descriptor:
 245:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  if (USB_Host_GetNextDescriptorComp(&BytesRemaining, &CurrentConfigLoc, EndpointSearcher) ==
 246:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *      Descriptor_Search_Comp_Found)
 247:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  {
 248:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *      // Do something with the endpoint descriptor
 249:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  }
 250:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  \endcode
 251:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 */
 252:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			uint8_t USB_GetNextDescriptorComp(uint16_t* const BytesRem,
 253:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			                                  void** const CurrConfigLoc,
 254:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			                                  ConfigComparatorPtr_t const ComparatorRoutine);
