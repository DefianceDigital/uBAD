  77:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  USB_Descriptor_Configuration_Header_t* ConfigHeaderPtr = DESCRIPTOR_PCAST(CurrDescriptor,
  78:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *                                                           USB_Descriptor_Configuration_Header
  79:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *
  80:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/ConfigDescriptor.h **** 			 *  // Can now access elements of the configuration header struct using the -> indirection opera
