 219:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			/** Function to reverse the individual bits in a byte - i.e. bit 7 is moved to bit 0, bit 6 to b
 220:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			 *  etc.
 221:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			 *
 222:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			 *  \param[in] Byte  Byte of data whose bits are to be reversed.
 223:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			 *
 224:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			 *  \return Input data with the individual bits reversed (mirrored).
 225:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			 */
 226:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			static inline uint8_t BitReverse(uint8_t Byte) ATTR_WARN_UNUSED_RESULT ATTR_CONST;
 227:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			static inline uint8_t BitReverse(uint8_t Byte)
 228:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			{
 229:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 				Byte = (((Byte & 0xF0) >> 4) | ((Byte & 0x0F) << 4));
 230:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 				Byte = (((Byte & 0xCC) >> 2) | ((Byte & 0x33) << 2));
 231:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 				Byte = (((Byte & 0xAA) >> 1) | ((Byte & 0x55) << 1));
 232:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 
 233:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 				return Byte;
 234:../lufa-LUFA-111009/LUFA/Drivers/USB/Core/../../../Common/Common.h **** 			}
